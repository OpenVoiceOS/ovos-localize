[1:]:\n                if not self.session_results[sess.session_id].get(\"stop_signaled\"):\n                    self.speak(s, wait=self.TIMEOUT_SECONDS_PER_SENTENCE)\n\n    LOG.debug(\"end of HowTo\")\n    self.session_results.pop(sess.session_id)\n    if sess.session_id == \"default\":\n    # ... (truncated)"}, "edit_urls": {"ca-ES": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/ca-es/step.dialog", "da-DK": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/da-dk/step.dialog", "de-DE": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/de-de/step.dialog", "en-US": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/en-us/step.dialog", "es-ES": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/es-es/step.dialog", "eu-ES": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/eu/step.dialog", "fr-FR": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/fr-fr/step.dialog", "gl-ES": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/gl-es/step.dialog", "it-IT": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/it-it/step.dialog", "pt-PT": "https://github.com/OpenVoiceOS/ovos-skill-wikihow/edit/dev/locale/pt-pt/step.dialog"}}, "wikihow.intent": {"type": "intent", "intent_system": "padatious", "langs": {"ca-ES": {"entries": [{"line": 1, "text": "(cerca|busca) (a|en|) (wiki how|wikihow) (sobre|com|) {query}"}, {"line": 2, "text": "què (diu|indica|pensa)(wiki how|wikihow) sobre {query}"}], "line_count": 2, "slots": ["query"], "validation": [], "file_path": "locale/ca-es/wikihow.intent"}, "da-DK": {"entries": [{"line": 1, "text": "hvad (gør|synes|mener|siger) (wiki how|wikihow)  om {query}"}, {"line": 2, "text": "søg (wiki how|wikihow) (for|efter|) {query}"}], "line_count": 2, "slots": ["query"], "validation": [], "file_path": "locale/da-dk/wikihow.intent"}, "de-DE": {"entries": [{"line": 1, "text": "Suche in (wiki how|wikihow) (